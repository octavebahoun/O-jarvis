{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "O-jarvis",
  "mainBinaryName": "o-jarvis",
  "version": "1.0.0",
  "identifier": "io.github.octavebahoun.ojarvis",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "O-jarvis",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#04060b",
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Assistant personnel desktop",
    "longDescription": "O-jarvis : on lui parle à voix haute, il se souvient, agit sous contrôle et sait s'étendre.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libportaudio2", "pulseaudio-utils", "libgtk-3-bin"],
        "recommends": ["bubblewrap", "xdg-desktop-portal-gnome"],
        "files": {
          "/usr/share/applications/io.github.octavebahoun.ojarvis.desktop": "packaging/io.github.octavebahoun.ojarvis.desktop"
        },
        "desktopTemplate": "packaging/generated.desktop"
      }
    }
  }
}
