#!/usr/bin/env bash
# Jarvis dans le terminal, depuis les sources, dans le dossier courant.
# Il rejoint le Jarvis de l'app s'il tourne, sinon il lance son propre moteur.
# Lien conseillé : ln -s "$PWD/scripts/o-jarvis-shell" ~/.local/bin/o-jarvis-shell
set -euo pipefail

root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
exec uv run --quiet --project "$root" o-jarvis-shell "$@"
