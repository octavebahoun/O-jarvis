{
  "manifest_version": 3,
  "name": "O-jarvis",
  "description": "Parle à Jarvis à côté de la page que tu regardes.",
  "version": "1.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "32": "icons/32.png", "128": "icons/128.png" },
  "action": { "default_title": "Ouvrir Jarvis" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "nativeMessaging", "tabs", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
